generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  Student
  Parent
  Tutor
  InstituteAdmin
  Admin
}

enum Language {
  en
  ar
}

enum VerificationStatus {
  Unverified
  Pending
  Verified
  Rejected
  Suspended
}

/// What is being sold (marketplace service category).
enum ServiceType {
  SchoolCourse
  UniversityCourse
  TrainingSkill
}

/// Who provides/offers the service (independent of account Role).
enum ProviderType {
  Teacher
  Institute
  Trainer
}

/// Who is learning/buying (preference/profile — does not restrict browsing).
enum LearnerType {
  SchoolStudent
  UniversityStudent
  Individual
}

enum CourseFormat {
  Online
  InPerson
  Hybrid
}

enum CourseStatus {
  Draft
  Published
  Paused
  Archived
}

enum SessionStatus {
  Scheduled
  InProgress
  Completed
  Cancelled
}

enum BookingStatus {
  Pending
  Confirmed
  Completed
  Cancelled
  Refunded
}

enum PaymentStatus {
  Pending
  Processing
  Paid
  Failed
  Refunded
  Cancelled
}

enum PayoutStatus {
  Pending
  Processing
  Paid
  Failed
  Cancelled
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  phone        String?
  firstName    String
  lastName     String
  role         Role
  language     Language @default(en)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentProfile          StudentProfile?
  parentProfile           ParentProfile?
  tutorProfile            TutorProfile?
  instituteMemberships    InstituteMember[]
  bookings                Booking[]
  reviews                 Review[]
  favorites               Favorite[]
  conversationParticipants ConversationParticipant[]
  messages                Message[]
  refreshTokens           RefreshToken[]
  coursesAsTutor          Course[]              @relation("TutorCourses")

  @@index([email])
  @@index([role])
}

model StudentProfile {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @unique @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  learnerType LearnerType?
  grade       String?
  school      String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ParentProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TutorProfile {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @db.Uuid
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Teacher vs Trainer — independent of account Role=Tutor.
  providerType       ProviderType       @default(Teacher)
  bio                String?
  expertise          String[]           @default([])
  verificationStatus VerificationStatus @default(Unverified)
  ratingAvg          Float              @default(0)
  ratingCount        Int                @default(0)
  studentCount       Int                @default(0)
  courseCount        Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  reviews            Review[]
  payouts            Payout[]

  @@index([verificationStatus])
  @@index([providerType])
}

model Institute {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String
  nameAr             String?
  description        String?
  verificationStatus VerificationStatus @default(Unverified)
  ratingAvg          Float              @default(0)
  ratingCount        Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  members   InstituteMember[]
  courses   Course[]
  favorites Favorite[]
  payouts   Payout[]

  @@index([verificationStatus])
}

model InstituteMember {
  id          String   @id @default(uuid()) @db.Uuid
  instituteId String   @db.Uuid
  userId      String   @db.Uuid
  role        String   @default("admin")
  createdAt   DateTime @default(now())

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([instituteId, userId])
  @@index([userId])
}

model CourseCategory {
  id       String  @id @default(uuid()) @db.Uuid
  slug     String  @unique
  nameEn   String
  nameAr   String
  parentId String? @db.Uuid
  parent   CourseCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children CourseCategory[] @relation("CategoryTree")
  courses  Course[]
  subjects Subject[]
}

model Subject {
  id         String  @id @default(uuid()) @db.Uuid
  nameEn     String
  nameAr     String
  categoryId String? @db.Uuid
  category   CourseCategory? @relation(fields: [categoryId], references: [id])
  courses    Course[]
}

model University {
  id      String    @id @default(uuid()) @db.Uuid
  nameEn  String
  nameAr  String?
  colleges College[]
  courses Course[]
}

model College {
  id           String     @id @default(uuid()) @db.Uuid
  nameEn       String
  nameAr       String?
  universityId String     @db.Uuid
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  courses      Course[]
}

model Course {
  id              String       @id @default(uuid()) @db.Uuid
  title           String
  titleAr         String?
  description     String
  descriptionAr   String?
  categoryId      String       @db.Uuid
  subjectId       String?      @db.Uuid
  /// Primary marketplace service type (not a provider or learner role).
  serviceType     ServiceType
  level           String?
  grade           String?
  stage           String?
  curriculumName  String?
  universityId    String?      @db.Uuid
  collegeId       String?      @db.Uuid
  courseCode      String?
  major           String?
  skillCategory   String?
  priceDecimal    Decimal      @db.Decimal(12, 3)
  currency        String       @default("BHD")
  durationMinutes Int?
  sessionCount    Int          @default(1)
  capacity        Int          @default(1)
  format          CourseFormat @default(Online)
  location        String?
  imageUrl        String?
  status          CourseStatus @default(Draft)
  tutorId         String?      @db.Uuid
  instituteId     String?      @db.Uuid
  ratingAvg       Float        @default(0)
  ratingCount     Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  category    CourseCategory         @relation(fields: [categoryId], references: [id])
  subject     Subject?               @relation(fields: [subjectId], references: [id])
  university  University?            @relation(fields: [universityId], references: [id])
  college     College?               @relation(fields: [collegeId], references: [id])
  tutor       User?                  @relation("TutorCourses", fields: [tutorId], references: [id])
  institute   Institute?             @relation(fields: [instituteId], references: [id])
  curriculum  CourseCurriculumItem[]
  sessions    CourseSession[]
  bookings    Booking[]
  reviews     Review[]
  favorites   Favorite[]

  @@index([courseCode])
  @@index([title])
  @@index([status])
  @@index([serviceType])
  @@index([tutorId])
  @@index([instituteId])
}

model CourseCurriculumItem {
  id          String  @id @default(uuid()) @db.Uuid
  courseId    String  @db.Uuid
  order       Int
  title       String
  titleAr     String?
  description String?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, order])
  @@index([courseId])
}

model CourseSession {
  id             String        @id @default(uuid()) @db.Uuid
  courseId       String        @db.Uuid
  startsAt       DateTime
  endsAt         DateTime
  seatsAvailable Int
  seatsTotal     Int
  status         SessionStatus @default(Scheduled)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([courseId])
  @@index([startsAt])
}

model Booking {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  courseId      String        @db.Uuid
  sessionId     String        @db.Uuid
  status        BookingStatus @default(Pending)
  priceSnapshot Decimal       @db.Decimal(12, 3)
  currency      String        @default("BHD")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user     User           @relation(fields: [userId], references: [id])
  course   Course         @relation(fields: [courseId], references: [id])
  session  CourseSession  @relation(fields: [sessionId], references: [id])
  payment  Payment?
  review   Review?

  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@unique([userId, sessionId])
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  bookingId   String        @unique @db.Uuid
  amount      Decimal       @db.Decimal(12, 3)
  currency    String        @default("BHD")
  status      PaymentStatus @default(Pending)
  provider    String
  providerRef String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @unique @db.Uuid
  userId    String   @db.Uuid
  courseId  String   @db.Uuid
  tutorId   String?  @db.Uuid
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  booking Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id])
  course  Course        @relation(fields: [courseId], references: [id])
  tutor   TutorProfile? @relation(fields: [tutorId], references: [id])

  @@index([courseId])
  @@index([tutorId])
}

model Favorite {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  courseId    String?  @db.Uuid
  tutorId     String?  @db.Uuid
  instituteId String?  @db.Uuid
  createdAt   DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course?    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  institute Institute? @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, courseId])
  @@unique([userId, tutorId])
  @@unique([userId, instituteId])
}

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  userId         String   @db.Uuid
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  senderId       String    @db.Uuid
  body           String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
}

model Payout {
  id          String       @id @default(uuid()) @db.Uuid
  tutorId     String?      @db.Uuid
  instituteId String?      @db.Uuid
  amount      Decimal      @db.Decimal(12, 3)
  currency    String       @default("BHD")
  status      PayoutStatus @default(Pending)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tutor     TutorProfile? @relation(fields: [tutorId], references: [id])
  institute Institute?    @relation(fields: [instituteId], references: [id])

  @@index([tutorId])
  @@index([instituteId])
  @@index([status])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}
